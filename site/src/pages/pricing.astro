---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';

const title = 'Pricing: Free Forever, All Features Included | Teanote';
const description = 'Teanote pricing is simple: the mindful tea journal and gongfu timer is free forever, with every feature included. No trial period, no payment details.';
---

<Layout
  title={title}
  description={description}
  canonical="https://teanote.xyz/pricing"
  ogTitle="Teanote Pricing: Free Forever | Mindful Tea Journal & Gongfu Brewing Timer"
  ogDescription="Teanote is free forever, with every feature included. No trial period, no card needed."
  twitterTitle="Teanote Pricing: Free Forever | Mindful Tea Journal & Gongfu Brewing Timer"
  twitterDescription="Teanote is free forever, with every feature included. No card needed."
>
  <Fragment slot="head">
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CPMZ66BNG7"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CPMZ66BNG7');
    </script>

    <!-- Structured Data: Product/Offers (no ratings/reviews yet) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": "Teanote",
        "brand": {"@type": "Brand", "name": "Teanote"},
        "description": "Mindful tea journal and gongfu brewing timer app.",
        "image": "https://teanote.xyz/img/og-home-2026.jpg",
        "offers": {
          "@type": "Offer",
          "priceCurrency": "USD",
          "price": "0",
          "url": "https://app.teanote.xyz",
          "name": "Free",
          "availability": "https://schema.org/InStock"
        }
      }
    </script>
  </Fragment>

  <Header />

  <main class="mx-auto max-w-6xl px-4">
    <section class="py-16 md:py-20">
      <h1 class="text-center text-4xl font-extrabold tracking-tight md:text-5xl">Pricing</h1>
      <p class="mx-auto mt-4 max-w-2xl text-center text-lg text-zinc-700 md:text-xl">
        Simple pricing: Teanote is free forever, with every feature included.
      </p>

      <div class="mx-auto mt-10 max-w-3xl">
        <div class="rounded-2xl border border-[#898565]/40 bg-gradient-to-br from-[#bdb695]/15 to-white p-7 shadow-sm">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-2xl font-extrabold">Teanote</h2>
              <p class="mt-1 text-sm font-semibold text-zinc-700">One plan, every feature included</p>
            </div>
            <div class="text-right">
              <div class="text-4xl font-extrabold tracking-tight">Free</div>
              <div class="text-sm font-semibold text-zinc-700">Forever, no trial period</div>
            </div>
          </div>

          <ul class="mt-6 space-y-2 text-zinc-800">
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-[#898565]"></span>No payment details needed</li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-[#898565]"></span>Cloud sync across all devices</li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-[#898565]"></span>Unlimited teas, journals & presets</li>
          </ul>

          <div class="mt-8">
            <Button href="https://app.teanote.xyz" variant="primary" class="w-full">Start, it's free forever</Button>
          </div>
        </div>
      </div>

      <div class="mx-auto mt-10 max-w-3xl rounded-2xl border border-zinc-200 bg-white p-7 text-center">
        <h2 class="text-2xl font-extrabold">Questions?</h2>
        <p class="mt-2 text-zinc-700">Email us at <a class="font-bold hover:text-[#898565]" href="mailto:info@teanote.xyz">info@teanote.xyz</a></p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
